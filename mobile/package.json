{
  "name": "hunteros-mobile",
  "version": "0.4.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "node scripts/import-catalog.mjs",
    "catalog": "node scripts/import-catalog.mjs",
    "start": "expo start --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/domain.test.mjs",
    "export": "expo export --platform all",
    "test:web": "playwright test"
  },
  "dependencies": {
    "expo": "~54.0.33",
    "expo-router": "~6.0.24",
    "expo-constants": "~18.0.14",
    "expo-linking": "~8.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-image": "~3.0.11",
    "expo-sqlite": "~16.0.10",
    "expo-file-system": "~19.0.24",
    "expo-document-picker": "~14.0.8",
    "expo-sharing": "~14.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "~0.21.0",
    "react-native-screens": "~4.16.0",
    "react-native-safe-area-context": "~5.6.0",
    "expo-camera": "~17.0.10",
    "@supabase/supabase-js": "^2.57.4",
    "expo-secure-store": "~15.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2",
    "@playwright/test": "^1.56.1"
  }
}
