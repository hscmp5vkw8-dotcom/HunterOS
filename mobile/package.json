{
  "name": "hunteros-mobile",
  "version": "0.5.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "postinstall": "node scripts/import-catalog.mjs",
    "catalog": "node scripts/import-catalog.mjs",
    "start": "expo start --go",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "export": "expo export --platform all",
    "test:web": "playwright test",
    "build:android": "npx eas-cli@24.7.0 build --platform android --profile preview",
    "build:ios": "npx eas-cli@24.7.0 build --platform ios --profile production",
    "submit:ios": "npx eas-cli@24.7.0 submit --platform ios --profile production",
    "build:android:play": "npx eas-cli@24.7.0 build --platform android --profile production",
    "submit:android:play": "npx eas-cli@24.7.0 submit --platform android --profile production"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-sharing": "~57.0.21",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "expo-camera": "~57.0.5",
    "expo-secure-store": "~57.0.4",
    "expo-dev-client": "~57.0.19",
    "@supabase/supabase-js": "^2.57.4",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/react": "~19.2.10",
    "typescript": "~6.0.3"
  }
}
