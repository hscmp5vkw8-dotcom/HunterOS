{
  "cli": {
    "version": ">= 24.7.0",
    "appVersionSource": "local"
  },
  "build": {
    "candidate": {
      "extends": "production",
      "autoIncrement": false
    },
    "beta-apk": {
      "extends": "candidate",
      "distribution": "internal",
      "autoIncrement": false,
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "extends": "preview",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815313376"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
