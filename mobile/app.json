{
  "expo": {
    "name": "HunterOS",
    "slug": "hunteros-mobile",
    "scheme": "hunteros",
    "version": "0.4.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.totalfreedomindustries.hunteros",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.totalfreedomindustries.hunteros",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HunterOS to scan gear barcodes and product labels."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
