{
  "expo": {
    "name": "HunterOS",
    "slug": "hunteros",
    "owner": "hunteross-team",
    "extra": {
      "eas": {
        "projectId": "be009c48-012c-4220-a8d7-764c090695aa"
      }
    },
    "scheme": "hunteros",
    "version": "0.6.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.totalfreedomindustries.hunteros",
      "buildNumber": "11",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.totalfreedomindustries.hunteros",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c100d"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HunterOS to scan gear barcodes and product labels.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon.png"
  }
}
