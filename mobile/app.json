{
  "expo": {
    "name": "HunterOS",
    "slug": "hunteros-mobile",
    "scheme": "hunteros",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.totalfreedomindustries.hunteros"
    },
    "android": {
      "package": "com.totalfreedomindustries.hunteros"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HunterOS to scan gear barcodes and product labels."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
